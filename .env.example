# Configure these in .env.local or your hosting provider; do not commit real credentials.
# Use a password with at least 12 characters and a random session secret with at least 32 characters.
QUOTE_ADMIN_USERNAME=
QUOTE_ADMIN_PASSWORD=
QUOTE_SESSION_SECRET=

# Contact details used throughout the site and as the contact-form recipient.
EMAIL=
ADDRESS=
PHONE=

#Resend API key for sending emails. You can get one at https://resend.com.
RESEND_API_KEY=re_xxx
MAIL_FROM=Harvest Moon <web@yourdomain.com>